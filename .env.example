# 用法: cp .env.example .env  然后填入你的真实配置

# ================= AWS 必填 =================
REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ================= 探测配置 =================
CHECK_PORT=443
# 检测间隔(分钟), 0=只跑一次
CHECK_INTERVAL_MINUTES=10

# ============ Telegram 通知(可选) ============
TG_NOTIFY=1
TG_BOT_TOKEN=
TG_CHAT_ID=

# ========= Cloudflare DNS 自动更新(可选) =========
CF_ENABLED=1
# API Token: CF面板 -> My Profile -> API Tokens -> Edit zone DNS 模板
CF_API_TOKEN=
# CF面板 -> 你的域名 -> Overview 页右下角 Zone ID
CF_ZONE_ID=
# 要更新的A记录, 如 subox.example.com
CF_RECORD_NAME=
